[run]
source = src
omit =
    src/__init__.py
    */tests/*
    */migrations/*
    src/repositories/*
    src/services/*
    src/tasks/*
    src/db_contexts/*
    src/data.py
    src/celery_app.py
    src/main.py

[report]
fail_under = 80
precision = 1
exclude_lines =
    def dispose
    def __init__
    pragma: no cover
    if __name__ == .__main__.
